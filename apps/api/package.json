{
  "name": "@autonova/api",
  "version": "0.0.0",
  "private": true,
  "description": "Autonova CRM REST API (NestJS modular monolith)",
  "type": "module",
  "scripts": {
    "prebuild": "pnpm run db:generate",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "pnpm run db:generate && nest start --watch",
    "typecheck": "pnpm run db:generate && tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.config.e2e.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:seed": "tsx prisma/seed.ts",
    "db:provision-app-role": "tsx scripts/provision-app-role.ts",
    "bench:argon2": "tsx scripts/bench-argon2.ts",
    "bootstrap:director": "nest build && node dist/cli/bootstrap-director.js"
  },
  "dependencies": {
    "@autonova/contracts": "workspace:*",
    "@autonova/enums": "workspace:*",
    "@autonova/validation": "workspace:*",
    "@nestjs/common": "catalog:",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "catalog:",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/platform-express": "^12.4.0",
    "@nestjs/swagger": "^12.1.1",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/throttler": "^6.7.1",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "helmet": "^8.3.0",
    "nestjs-pino": "^5.3.1",
    "pg": "^8.16.3",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@autonova/config": "workspace:*",
    "@nestjs/cli": "^12.0.12",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.4.0",
    "@types/express": "^5.0.0",
    "@types/node": "catalog:",
    "@types/pg": "^8.16.0",
    "@types/supertest": "^7.0.0",
    "pino-pretty": "^13.0.0",
    "prisma": "7.10.1",
    "supertest": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "vite": "^8.0.0",
    "vitest": "catalog:"
  }
}
