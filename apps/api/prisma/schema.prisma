// Autonova CRM — identity/access foundation and first lead lifecycle slice.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum AuditCategory {
  /// Business mutation, written in the same transaction as the change it describes.
  BUSINESS
  /// Authentication/security event (failed login, token reuse, ...), written on its own.
  SECURITY
}

enum LeadSource {
  REFERRAL
  INSTAGRAM
  WEBSITE
  WALK_IN
  EVENT
  COLD_OUTREACH
  EXISTING_CLIENT_UPSELL
}

enum CompanyIndustry {
  RETAIL
  HOSPITALITY
  AUTOMOTIVE
  MANUFACTURING
  LOGISTICS
  EDUCATION
  HEALTHCARE
  FINANCE
  AGRICULTURE
  REAL_ESTATE
  TECHNOLOGY
  GOVERNMENT
  OTHER
}

enum ActivityType {
  VISIT
  CALL
  DEMO
  MEETING
}

enum AttachmentCategory {
  PHOTO
  VOICE_NOTE
  DOCUMENT
}

enum ProductInterest {
  RETAIL_POS
  CAR_WASH_AUTOMATION
  ERP
  VISITOR_SECURITY_SYSTEM
  HIRING_PLATFORM
  CUSTOM_BUILD
}

enum LeadReminderStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum LeadReminderReason {
  SMTP_NOT_CONFIGURED
  DELIVERY_FAILED
  LEAD_NOT_ACTIVE
  FOLLOW_UP_CHANGED
  RECIPIENT_UNAVAILABLE
  TOO_OVERDUE
}

enum LeadStage {
  NEW_LEAD
  VISITS_AND_CALLS
  QUALIFIED
  SCOPE_ALIGNMENT
  TOR_QUOTE_SENT
  DISQUALIFIED
  WON
  LOST
}

enum LeadDisqualificationReason {
  NO_BUDGET
  NO_DECISION_MAKER
  NEED_DOES_NOT_FIT
  CHOSE_COMPETITOR
  UNRESPONSIVE
  TIMING_REVISIT_LATER
  OTHER
}

enum LeadTransitionSource {
  MANUAL
  SCHEDULED_REVISIT
  TOR_SENT
  CONVERSION
}

enum QualificationRating {
  NOT_MET
  PARTIALLY_MET
  FULLY_MET
}

enum TorVersionStatus {
  DRAFT
  SENT
  SIGNED
  SUPERSEDED
}

enum DiscountType {
  NONE
  PERCENT
  AMOUNT
}

enum VatTreatment {
  APPLIED
  EXEMPT
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum TorAddonKind {
  TRAINING_DAYS
  HARDWARE
  DATA_MIGRATION
  SMS_BUNDLE
  OTHER
}

enum MilestoneKind {
  REQUIREMENTS_SIGN_OFF
  DEMO
  UAT
  GO_LIVE
  TRAINING
  OTHER
}

enum SignatureParty {
  CLIENT
  AUTONOVA
}

enum SignatureMethod {
  TYPED_NAME
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  EXPIRED
  REJECTED
}

enum QuotationKind {
  FROM_TOR
  QUICK
}

enum QuotationLineKind {
  SCOPE
  ADDON
  CUSTOM
}

enum ClientAccountStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

/// A person who can sign in. Users are never hard-deleted: they are referenced by
/// audit events and (later) by leads, ToRs and payments. Use status = DISABLED instead.
model User {
  id           String     @id @default(uuid(7)) @db.Uuid
  email        String     @unique
  fullName     String     @map("full_name")
  passwordHash String?    @map("password_hash")
  status       UserStatus @default(INVITED)
  lastLoginAt  DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  roles               UserRole[]
  invitations         UserInvitation[]
  auditLogs           AuditLog[]
  sessions            Session[]
  mfa                 UserMfa?
  ownedLeads          Lead[]               @relation("LeadOwner")
  createdLeads        Lead[]               @relation("LeadCreator")
  leadTransitions     LeadStageHistory[]   @relation("LeadTransitionActor")
  lostLeads           Lead[]               @relation("LeadLostBy")
  disqualifiedLeads   Lead[]               @relation("LeadDisqualifiedBy")
  leadReminders       LeadReminder[]       @relation("LeadReminderRecipient")
  heldActivities      Activity[]           @relation("ActivityHoldPlacer")
  linkedAttendees     ActivityAttendee[]   @relation("AttendeeLinker")
  purgedAttachments   ActivityAttachment[] @relation("AttachmentPurger")
  archivedAttachments ActivityAttachment[] @relation("AttachmentArchiver")
  createdCompanies    Company[]            @relation("CompanyCreator")
  updatedCompanies    Company[]            @relation("CompanyUpdater")
  archivedCompanies   Company[]            @relation("CompanyArchiver")
  createdContacts     Contact[]            @relation("ContactCreator")
  createdActivities   Activity[]           @relation("ActivityCreator")
  updatedActivities   Activity[]           @relation("ActivityUpdater")
  archivedActivities  Activity[]           @relation("ActivityArchiver")
  uploadedAttachments ActivityAttachment[] @relation("AttachmentUploader")
  updatedContacts     Contact[]            @relation("ContactUpdater")
  updatedSettings     SystemSetting[]      @relation("SettingUpdater")
  assessedLeads       LeadQualification[]  @relation("QualificationAssessor")
  createdCatalogue    CatalogueItem[]      @relation("CatalogueCreator")
  createdTors         Tor[]                @relation("TorCreator")
  createdTorVersions  TorVersion[]         @relation("TorVersionCreator")
  sentTorVersions     TorVersion[]         @relation("TorVersionSender")
  approvedTorVersions TorVersion[]         @relation("TorDiscountApprover")
  recordedSignatures  TorSignature[]       @relation("TorSignatureRecorder")
  createdQuotations   Quotation[]          @relation("QuotationCreator")
  convertedClients    ClientAccount[]      @relation("ClientConverter")

  @@map("users")
}

/// Hashed, single-use onboarding links. Plain invitation tokens are emailed once and never stored.
model UserInvitation {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt])
  @@map("user_invitations")
}

/// Lead/opportunity aggregate. Stage transitions and outcome history are separate records.
model Lead {
  id                     String                      @id @default(uuid(7)) @db.Uuid
  name                   String
  companyName            String?                     @map("company_name")
  phone                  String?
  email                  String?
  source                 LeadSource
  referrerName           String?                     @map("referrer_name")
  productInterest        ProductInterest?            @map("product_interest")
  legacyProductInterest  String?                     @map("legacy_product_interest")
  /// Comparison keys for duplicate detection; always written with the lead (domain/lead-duplicates.ts).
  /// Null for an individual prospect. `company_name` keeps the text captured at entry; once a lead is
  /// linked, the company record is the source of truth for the name.
  companyId              String?                     @map("company_id") @db.Uuid
  primaryContactId       String?                     @map("primary_contact_id") @db.Uuid
  phoneNormalized        String?                     @map("phone_normalized")
  companyNameNormalized  String?                     @map("company_name_normalized")
  notes                  String?
  estimatedValue         Decimal?                    @map("estimated_value") @db.Decimal(14, 2)
  currency               String                      @default("KES")
  stage                  LeadStage                   @default(NEW_LEAD)
  lostReason             String?                     @map("lost_reason")
  lostAt                 DateTime?                   @map("lost_at") @db.Timestamptz(3)
  lostByUserId           String?                     @map("lost_by_user_id") @db.Uuid
  disqualificationReason LeadDisqualificationReason? @map("disqualification_reason")
  disqualifiedAt         DateTime?                   @map("disqualified_at") @db.Timestamptz(3)
  disqualifiedByUserId   String?                     @map("disqualified_by_user_id") @db.Uuid
  revisitOn              DateTime?                   @map("revisit_on") @db.Date
  ownerUserId            String                      @map("owner_user_id") @db.Uuid
  createdByUserId        String                      @map("created_by_user_id") @db.Uuid
  nextAction             String                      @map("next_action")
  nextActionAt           DateTime                    @map("next_action_at") @db.Timestamptz(3)
  probability            Int?
  createdAt              DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner          User                @relation("LeadOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  creator        User                @relation("LeadCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  lostBy         User?               @relation("LeadLostBy", fields: [lostByUserId], references: [id], onDelete: Restrict)
  disqualifiedBy User?               @relation("LeadDisqualifiedBy", fields: [disqualifiedByUserId], references: [id], onDelete: Restrict)
  stageHistory   LeadStageHistory[]
  reminders      LeadReminder[]
  company        Company?            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  primaryContact Contact?            @relation("LeadPrimaryContact", fields: [primaryContactId], references: [id], onDelete: Restrict)
  contacts       LeadContact[]
  activities     Activity[]
  qualifications LeadQualification[]
  tor            Tor?
  quotations     Quotation[]
  clientAccount  ClientAccount?

  @@index([companyId, ownerUserId])
  @@index([primaryContactId])
  @@index([ownerUserId, stage, updatedAt(sort: Desc)])
  @@index([phoneNormalized])
  @@index([companyNameNormalized])
  @@index([nextActionAt])
  @@index([createdAt(sort: Desc)])
  @@map("leads")
}

/// Immutable domain history. The runtime DB role receives INSERT/SELECT only.
/// An organisation Autonova deals with, separate from its people and its deals (PRD 4.2).
/// Archived instead of deleted: leads, contacts and later ToRs/accounts keep referencing it.
model Company {
  id               String           @id @default(uuid(7)) @db.Uuid
  name             String
  /// Lower-case words without punctuation or a trailing legal suffix (domain/company-keys.ts).
  nameNormalized   String           @map("name_normalized")
  kraPin           String?          @map("kra_pin")
  location         String?
  industry         CompanyIndustry?
  staffCount       Int?             @map("staff_count")
  branchCount      Int?             @map("branch_count")
  website          String?
  socialLinks      String[]         @default([]) @map("social_links")
  archivedAt       DateTime?        @map("archived_at") @db.Timestamptz(3)
  archivedByUserId String?          @map("archived_by_user_id") @db.Uuid
  createdByUserId  String           @map("created_by_user_id") @db.Uuid
  updatedByUserId  String           @map("updated_by_user_id") @db.Uuid
  /// Set when the legacy-text backfill created this row from a name that closely matches another.
  needsReview      Boolean          @default(false) @map("needs_review")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy      User            @relation("CompanyCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy      User            @relation("CompanyUpdater", fields: [updatedByUserId], references: [id], onDelete: Restrict)
  archivedBy     User?           @relation("CompanyArchiver", fields: [archivedByUserId], references: [id], onDelete: Restrict)
  contacts       Contact[]
  leads          Lead[]
  clientAccounts ClientAccount[]

  @@index([nameNormalized])
  @@index([createdByUserId])
  @@map("companies")
}

/// A person at one company. Phone and email are not unique: colleagues share switchboards and inboxes.
model Contact {
  id              String       @id @default(uuid(7)) @db.Uuid
  companyId       String       @map("company_id") @db.Uuid
  name            String
  jobTitle        String?      @map("job_title")
  phone           String?
  phoneNormalized String?      @map("phone_normalized")
  email           String?
  whatsappNumber  String?      @map("whatsapp_number")
  isDecisionMaker Boolean      @default(false) @map("is_decision_maker")
  role            ContactRole?
  archivedAt      DateTime?    @map("archived_at") @db.Timestamptz(3)
  createdByUserId String       @map("created_by_user_id") @db.Uuid
  updatedByUserId String       @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  company     Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdBy   User               @relation("ContactCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy   User               @relation("ContactUpdater", fields: [updatedByUserId], references: [id], onDelete: Restrict)
  primaryFor  Lead[]             @relation("LeadPrimaryContact")
  leadLinks   LeadContact[]
  attendances ActivityAttendee[]

  @@index([companyId, archivedAt])
  @@map("contacts")
}

enum ContactRole {
  OWNER
  MANAGER
  FINANCE
  TECHNICAL
  OTHER
}

/// Other contacts involved in a deal. The primary contact lives on leads.primary_contact_id.
model LeadContact {
  leadId    String   @map("lead_id") @db.Uuid
  contactId String   @map("contact_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  lead    Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Restrict)

  @@id([leadId, contactId])
  @@index([contactId])
  @@map("lead_contacts")
}

/// One interaction with a prospect (PRD 4.3): a meeting, site visit, demo or call. It belongs to a lead
/// only; the company and contacts come through the lead so nothing is stored twice. Archived, never
/// deleted. `occurred_at` is when it happened, `created_at` when it was recorded.
model Activity {
  id                 String       @id @default(uuid(7)) @db.Uuid
  leadId             String       @map("lead_id") @db.Uuid
  type               ActivityType
  occurredAt         DateTime     @map("occurred_at") @db.Timestamptz(3)
  location           String?
  latitude           Decimal?     @db.Decimal(9, 6)
  longitude          Decimal?     @db.Decimal(9, 6)
  discussion         String
  painPoints         String?      @map("pain_points")
  currentTools       String?      @map("current_tools")
  nextSteps          String?      @map("next_steps")
  /// When the check-in was captured: the start of its retention period. Null with no position.
  gpsRecordedAt      DateTime?    @map("gps_recorded_at") @db.Timestamptz(3)
  /// Set when retention cleared the position; the report itself is kept.
  gpsClearedAt       DateTime?    @map("gps_cleared_at") @db.Timestamptz(3)
  archivedAt         DateTime?    @map("archived_at") @db.Timestamptz(3)
  archivedByUserId   String?      @map("archived_by_user_id") @db.Uuid
  archivedReason     String?      @map("archived_reason")
  /// A legal hold or approved retention exception: while set, retention never touches this report.
  holdReference      String?      @map("hold_reference")
  holdReason         String?      @map("hold_reason")
  holdPlacedAt       DateTime?    @map("hold_placed_at") @db.Timestamptz(3)
  holdPlacedByUserId String?      @map("hold_placed_by_user_id") @db.Uuid
  createdByUserId    String       @map("created_by_user_id") @db.Uuid
  updatedByUserId    String       @map("updated_by_user_id") @db.Uuid
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  holdPlacedBy User?                @relation("ActivityHoldPlacer", fields: [holdPlacedByUserId], references: [id], onDelete: Restrict)
  lead         Lead                 @relation(fields: [leadId], references: [id], onDelete: Restrict)
  createdBy    User                 @relation("ActivityCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy    User                 @relation("ActivityUpdater", fields: [updatedByUserId], references: [id], onDelete: Restrict)
  archivedBy   User?                @relation("ActivityArchiver", fields: [archivedByUserId], references: [id], onDelete: Restrict)
  attendees    ActivityAttendee[]
  attachments  ActivityAttachment[]

  @@index([leadId, occurredAt(sort: Desc), id(sort: Desc)])
  @@index([createdByUserId])
  @@map("activities")
}

/// A person who took part: an existing contact of the lead's company, or an outside person.
model ActivityAttendee {
  id             String    @id @default(uuid(7)) @db.Uuid
  activityId     String    @map("activity_id") @db.Uuid
  contactId      String?   @map("contact_id") @db.Uuid
  externalName   String?   @map("external_name")
  organisation   String?
  /// Set when an outside attendee was later linked to a CRM contact; the name above stays as recorded.
  linkedAt       DateTime? @map("linked_at") @db.Timestamptz(3)
  linkedByUserId String?   @map("linked_by_user_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  contact  Contact? @relation(fields: [contactId], references: [id], onDelete: Restrict)
  linkedBy User?    @relation("AttendeeLinker", fields: [linkedByUserId], references: [id], onDelete: Restrict)

  @@index([activityId])
  @@index([contactId])
  @@map("activity_attendees")
}

/// Metadata only. The bytes live in private file storage under `storage_key`, a random server-made key
/// that never contains the client's file name. Archived, never deleted; the blob is purged by the
/// retention procedure (docs/06).
model ActivityAttachment {
  id                   String             @id @default(uuid(7)) @db.Uuid
  activityId           String             @map("activity_id") @db.Uuid
  category             AttachmentCategory
  fileName             String             @map("file_name")
  storageKey           String             @unique @map("storage_key")
  mimeType             String             @map("mime_type")
  sizeBytes            Int                @map("size_bytes")
  sha256               String
  uploadedByUserId     String             @map("uploaded_by_user_id") @db.Uuid
  /// Voice notes only: whether the uploader confirmed the participants were told they were recorded.
  recordingNoticeGiven Boolean?           @map("recording_notice_given")
  archivedAt           DateTime?          @map("archived_at") @db.Timestamptz(3)
  archivedByUserId     String?            @map("archived_by_user_id") @db.Uuid
  archivedReason       String?            @map("archived_reason")
  /// Set when the reviewed retention process removed the stored file; the row stays as the record.
  purgedAt             DateTime?          @map("purged_at") @db.Timestamptz(3)
  purgedByUserId       String?            @map("purged_by_user_id") @db.Uuid
  purgeReason          String?            @map("purge_reason")
  purgeReference       String?            @map("purge_reference")
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Restrict)
  uploadedBy User     @relation("AttachmentUploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  purgedBy   User?    @relation("AttachmentPurger", fields: [purgedByUserId], references: [id], onDelete: Restrict)
  archivedBy User?    @relation("AttachmentArchiver", fields: [archivedByUserId], references: [id], onDelete: Restrict)

  @@index([activityId, archivedAt])
  @@map("activity_attachments")
}

/// One delivery record per lead follow-up instant. (lead_id, due_at) is unique, so a follow-up is
/// reminded at most once no matter how often or from how many processes the worker runs.
model LeadReminder {
  id              String              @id @default(uuid(7)) @db.Uuid
  leadId          String              @map("lead_id") @db.Uuid
  recipientUserId String              @map("recipient_user_id") @db.Uuid
  dueAt           DateTime            @map("due_at") @db.Timestamptz(3)
  status          LeadReminderStatus  @default(PENDING)
  attempts        Int                 @default(0)
  nextAttemptAt   DateTime            @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  lastAttemptAt   DateTime?           @map("last_attempt_at") @db.Timestamptz(3)
  sentAt          DateTime?           @map("sent_at") @db.Timestamptz(3)
  reason          LeadReminderReason?
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  lead      Lead @relation(fields: [leadId], references: [id], onDelete: Restrict)
  recipient User @relation("LeadReminderRecipient", fields: [recipientUserId], references: [id], onDelete: Restrict)

  @@unique([leadId, dueAt])
  @@index([status, nextAttemptAt])
  @@map("lead_reminders")
}

model LeadStageHistory {
  id                     String                      @id @default(uuid(7)) @db.Uuid
  leadId                 String                      @map("lead_id") @db.Uuid
  fromStage              LeadStage?                  @map("from_stage")
  toStage                LeadStage                   @map("to_stage")
  actorUserId            String?                     @map("actor_user_id") @db.Uuid
  occurredAt             DateTime                    @default(now()) @map("occurred_at") @db.Timestamptz(3)
  reason                 String?
  disqualificationReason LeadDisqualificationReason? @map("disqualification_reason")
  revisitOn              DateTime?                   @map("revisit_on") @db.Date
  source                 LeadTransitionSource        @default(MANUAL)
  /// The BANT assessment a move to Qualified relied on, and whether a Director overrode a failing result.
  qualificationId        String?                     @map("qualification_id") @db.Uuid
  qualificationOverride  Boolean                     @default(false) @map("qualification_override")

  lead          Lead               @relation(fields: [leadId], references: [id], onDelete: Restrict)
  qualification LeadQualification? @relation(fields: [qualificationId], references: [id], onDelete: Restrict)
  actor         User?              @relation("LeadTransitionActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([leadId, occurredAt(sort: Desc)])
  @@index([toStage, disqualificationReason, occurredAt(sort: Desc)])
  @@index([toStage, revisitOn])
  @@map("lead_stage_history")
}

/// One sign-in on one device. Access tokens carry its id (`sid`); the API checks on EVERY request
/// that the session is neither revoked nor expired, so revocation takes effect immediately.
model Session {
  id            String    @id @default(uuid(7)) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Absolute lifetime; idle timeout is an open decision (docs/06, S6).
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedReason String?   @map("revoked_reason")
  /// Set when the second factor was verified for this session. A user whose roles require MFA
  /// (Directors) has a *restricted* session until this is set (docs/06 "Director MFA").
  mfaVerifiedAt DateTime? @map("mfa_verified_at") @db.Timestamptz(3)
  ip            String?
  userAgent     String?   @map("user_agent")

  user          User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  refreshTokens RefreshToken[]

  /// "Active sessions of a user" (session list, revoke-all on disable/password change).
  @@index([userId, revokedAt])
  @@map("sessions")
}

/// Encrypted TOTP enrollment and verification state. Plaintext secrets are only handled by AuthMfaService.
model UserMfa {
  userId           String    @id @map("user_id") @db.Uuid
  secretCiphertext String?   @map("secret_ciphertext")
  secretIv         String?   @map("secret_iv")
  secretTag        String?   @map("secret_tag")
  enrolledAt       DateTime? @map("enrolled_at") @db.Timestamptz(3)
  lastAcceptedStep BigInt?   @map("last_accepted_step")
  failedAttempts   Int       @default(0) @map("failed_attempts")
  lockedUntil      DateTime? @map("locked_until") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user          User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  recoveryCodes MfaRecoveryCode[]

  @@map("user_mfa")
}

/// High-entropy one-time recovery code digests; plaintext is returned only once at enrollment.
model MfaRecoveryCode {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @unique @map("code_hash")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)

  mfa UserMfa @relation(fields: [userId], references: [userId], onDelete: Restrict)

  @@index([userId, usedAt])
  @@map("mfa_recovery_codes")
}

/// One refresh token issued for a session. A session IS the token family: every rotation of a
/// session's refresh token adds a row here, so revoking the session (sessions.revoked_at) revokes
/// all of its tokens and no separate family id or per-token revocation flag exists.
///
/// Only the SHA-256 of the opaque token is stored; the raw value exists in the HttpOnly cookie only.
/// Rotation consumes a token with a conditional UPDATE (used_at IS NULL), so exactly one concurrent
/// request wins; presenting an already-used token is replay and revokes the session.
/// The migration adds, by hand, a partial unique index (one unused token per session) and CHECKs.
model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  /// Lower-case hex SHA-256 of the raw token. Lookup key; UNIQUE so a hash can never match two rows.
  tokenHash String    @unique @map("token_hash")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Never later than the session's own expiry.
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  /// Set exactly once, by the rotation that consumed this token. Non-null means "already used".
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)

  session Session @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@index([sessionId])
  @@map("refresh_tokens")
}

/// Roles are data, not code, so permissions are never tied to individual people.
model Role {
  id          String   @id @default(uuid(7)) @db.Uuid
  key         String   @unique
  name        String
  description String?
  /// System roles are seeded and cannot be deleted or have their key changed.
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

/// A single capability, e.g. `users:manage`. Keys follow `<resource>:<action>`.
model Permission {
  id          String   @id @default(uuid(7)) @db.Uuid
  key         String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  roles RolePermission[]

  @@map("permissions")
}

/// Many-to-many: a role grants many permissions, a permission belongs to many roles.
model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// Many-to-many: one person can hold several roles (e.g. Director + Technical Lead).
model UserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

/// Append-only record of important business actions (PRD 2.2, 8.5).
/// UPDATE and DELETE are rejected by a database trigger (see the init migration).
/// old_values / new_values are JSON snapshots: they are document-like, vary by entity
/// and are never queried relationally.
model AuditLog {
  id          String        @id @default(uuid(7)) @db.Uuid
  occurredAt  DateTime      @default(now()) @map("occurred_at") @db.Timestamptz(3)
  /// Null only for system-initiated actions (jobs, seed).
  actorUserId String?       @map("actor_user_id") @db.Uuid
  category    AuditCategory @default(BUSINESS)
  action      String
  entityType  String        @map("entity_type")
  entityId    String        @map("entity_id")
  oldValues   Json?         @map("old_values")
  newValues   Json?         @map("new_values")
  reason      String?
  requestId   String?       @map("request_id")

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, occurredAt(sort: Desc)])
  @@index([actorUserId, occurredAt(sort: Desc)])
  @@index([occurredAt(sort: Desc)])
  @@index([category, occurredAt(sort: Desc)])
  @@map("audit_logs")
}

/// Settings the Director can change without a deploy. Values are validated by the owning module before
/// they are written; a missing row means "use the documented default".
model SystemSetting {
  key             String   @id
  value           Json
  updatedByUserId String?  @map("updated_by_user_id") @db.Uuid
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  updatedBy User? @relation("SettingUpdater", fields: [updatedByUserId], references: [id], onDelete: Restrict)

  @@map("system_settings")
}

/// A managed number series (quotations, ToRs, client accounts), one counter per series and year.
model NumberSequence {
  series    String
  year      Int
  lastValue Int    @map("last_value")

  @@id([series, year])
  @@map("number_sequences")
}

/// One BANT assessment. Insert-only history: the latest row is the current assessment. The pass mark and
/// weights in force are copied onto the row so a later settings change never rewrites an old result.
model LeadQualification {
  id               String              @id @default(uuid(7)) @db.Uuid
  leadId           String              @map("lead_id") @db.Uuid
  budgetRating     QualificationRating @map("budget_rating")
  authorityRating  QualificationRating @map("authority_rating")
  needRating       QualificationRating @map("need_rating")
  timelineRating   QualificationRating @map("timeline_rating")
  score            Int
  passMark         Int                 @map("pass_mark")
  weights          Json
  passed           Boolean
  notes            String?
  assessedByUserId String              @map("assessed_by_user_id") @db.Uuid
  assessedAt       DateTime            @default(now()) @map("assessed_at") @db.Timestamptz(3)

  lead       Lead               @relation(fields: [leadId], references: [id], onDelete: Restrict)
  assessedBy User               @relation("QualificationAssessor", fields: [assessedByUserId], references: [id], onDelete: Restrict)
  history    LeadStageHistory[]

  @@index([leadId, assessedAt(sort: Desc)])
  @@map("lead_qualifications")
}

/// Reusable scope item. Copied into a ToR version when chosen; later edits here never change a ToR.
model CatalogueItem {
  id              String           @id @default(uuid(7)) @db.Uuid
  name            String
  description     String?
  productInterest ProductInterest? @map("product_interest")
  defaultDays     Decimal          @map("default_days") @db.Decimal(6, 2)
  defaultPrice    Decimal          @map("default_price") @db.Decimal(14, 2)
  currency        String           @default("KES")
  active          Boolean          @default(true)
  createdByUserId String           @map("created_by_user_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy  User           @relation("CatalogueCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  scopeItems TorScopeItem[]

  @@index([active, name])
  @@map("catalogue_items")
}

/// The scope agreement of one deal (lead). Its content lives in numbered versions.
model Tor {
  id              String   @id @default(uuid(7)) @db.Uuid
  number          String   @unique
  leadId          String   @unique @map("lead_id") @db.Uuid
  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  lead          Lead            @relation(fields: [leadId], references: [id], onDelete: Restrict)
  createdBy     User            @relation("TorCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  versions      TorVersion[]
  clientAccount ClientAccount[]

  @@map("tors")
}

/// One scope-alignment round. DRAFT is editable; SENT, SIGNED and SUPERSEDED are frozen by database triggers.
model TorVersion {
  id                       String           @id @default(uuid(7)) @db.Uuid
  torId                    String           @map("tor_id") @db.Uuid
  versionNo                Int              @map("version_no")
  status                   TorVersionStatus @default(DRAFT)
  currency                 String           @default("KES")
  setupFee                 Decimal          @default(0) @map("setup_fee") @db.Decimal(14, 2)
  discountType             DiscountType     @default(NONE) @map("discount_type")
  discountValue            Decimal          @default(0) @map("discount_value") @db.Decimal(14, 2)
  hostingName              String?          @map("hosting_name")
  hostingDescription       String?          @map("hosting_description")
  hostingCycle             BillingCycle?    @map("hosting_cycle")
  hostingAmount            Decimal          @default(0) @map("hosting_amount") @db.Decimal(14, 2)
  paymentTerms             String?          @map("payment_terms")
  vatTreatment             VatTreatment     @default(APPLIED) @map("vat_treatment")
  vatRate                  Decimal          @default(16) @map("vat_rate") @db.Decimal(5, 2)
  changeSummary            String?          @map("change_summary")
  scopeTotal               Decimal          @default(0) @map("scope_total") @db.Decimal(14, 2)
  addonsTotal              Decimal          @default(0) @map("addons_total") @db.Decimal(14, 2)
  oneOffSubtotal           Decimal          @default(0) @map("one_off_subtotal") @db.Decimal(14, 2)
  discountAmount           Decimal          @default(0) @map("discount_amount") @db.Decimal(14, 2)
  netOneOff                Decimal          @default(0) @map("net_one_off") @db.Decimal(14, 2)
  vatOneOff                Decimal          @default(0) @map("vat_one_off") @db.Decimal(14, 2)
  totalOneOff              Decimal          @default(0) @map("total_one_off") @db.Decimal(14, 2)
  recurringVat             Decimal          @default(0) @map("recurring_vat") @db.Decimal(14, 2)
  recurringTotal           Decimal          @default(0) @map("recurring_total") @db.Decimal(14, 2)
  discountApprovedByUserId String?          @map("discount_approved_by_user_id") @db.Uuid
  discountApprovedAt       DateTime?        @map("discount_approved_at") @db.Timestamptz(3)
  sentAt                   DateTime?        @map("sent_at") @db.Timestamptz(3)
  sentByUserId             String?          @map("sent_by_user_id") @db.Uuid
  contentHash              String?          @map("content_hash")
  signedAt                 DateTime?        @map("signed_at") @db.Timestamptz(3)
  createdByUserId          String           @map("created_by_user_id") @db.Uuid
  createdAt                DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tor              Tor            @relation(fields: [torId], references: [id], onDelete: Restrict)
  createdBy        User           @relation("TorVersionCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  sentBy           User?          @relation("TorVersionSender", fields: [sentByUserId], references: [id], onDelete: Restrict)
  discountApprover User?          @relation("TorDiscountApprover", fields: [discountApprovedByUserId], references: [id], onDelete: Restrict)
  scopeItems       TorScopeItem[]
  addons           TorAddon[]
  milestones       TorMilestone[]
  signatures       TorSignature[]
  quotations       Quotation[]
  clientAccount    ClientAccount?

  @@unique([torId, versionNo])
  @@index([status, sentAt])
  @@map("tor_versions")
}

model TorScopeItem {
  id              String  @id @default(uuid(7)) @db.Uuid
  torVersionId    String  @map("tor_version_id") @db.Uuid
  /// Stable across versions so a later round can say which item was added, dropped or changed.
  itemKey         String  @map("item_key") @db.Uuid
  catalogueItemId String? @map("catalogue_item_id") @db.Uuid
  position        Int
  name            String
  description     String?
  inScope         Boolean @default(true) @map("in_scope")
  estimateDays    Decimal @default(0) @map("estimate_days") @db.Decimal(6, 2)
  price           Decimal @default(0) @db.Decimal(14, 2)

  version   TorVersion     @relation(fields: [torVersionId], references: [id], onDelete: Restrict)
  catalogue CatalogueItem? @relation(fields: [catalogueItemId], references: [id], onDelete: Restrict)

  @@index([torVersionId, position])
  @@map("tor_scope_items")
}

model TorAddon {
  id           String       @id @default(uuid(7)) @db.Uuid
  torVersionId String       @map("tor_version_id") @db.Uuid
  kind         TorAddonKind
  description  String
  quantity     Decimal      @default(1) @db.Decimal(8, 2)
  unitPrice    Decimal      @default(0) @map("unit_price") @db.Decimal(14, 2)
  position     Int

  version TorVersion @relation(fields: [torVersionId], references: [id], onDelete: Restrict)

  @@index([torVersionId, position])
  @@map("tor_addons")
}

model TorMilestone {
  id           String        @id @default(uuid(7)) @db.Uuid
  torVersionId String        @map("tor_version_id") @db.Uuid
  kind         MilestoneKind
  name         String
  targetDate   DateTime      @map("target_date") @db.Date
  position     Int

  version TorVersion @relation(fields: [torVersionId], references: [id], onDelete: Restrict)

  @@index([torVersionId, position])
  @@map("tor_milestones")
}

/// One party's sign-off on one exact version. Insert-only; at most one per party per version.
model TorSignature {
  id               String          @id @default(uuid(7)) @db.Uuid
  torVersionId     String          @map("tor_version_id") @db.Uuid
  party            SignatureParty
  signerName       String          @map("signer_name")
  signerTitle      String?         @map("signer_title")
  method           SignatureMethod @default(TYPED_NAME)
  evidenceNote     String?         @map("evidence_note")
  contentHash      String          @map("content_hash")
  signedAt         DateTime        @default(now()) @map("signed_at") @db.Timestamptz(3)
  recordedByUserId String          @map("recorded_by_user_id") @db.Uuid

  version    TorVersion @relation(fields: [torVersionId], references: [id], onDelete: Restrict)
  recordedBy User       @relation("TorSignatureRecorder", fields: [recordedByUserId], references: [id], onDelete: Restrict)

  @@unique([torVersionId, party])
  @@map("tor_signatures")
}

model Quotation {
  id              String          @id @default(uuid(7)) @db.Uuid
  number          String          @unique
  leadId          String          @map("lead_id") @db.Uuid
  kind            QuotationKind
  torVersionId    String?         @map("tor_version_id") @db.Uuid
  status          QuotationStatus @default(DRAFT)
  currency        String          @default("KES")
  validUntil      DateTime        @map("valid_until") @db.Date
  vatTreatment    VatTreatment    @default(APPLIED) @map("vat_treatment")
  vatRate         Decimal         @default(16) @map("vat_rate") @db.Decimal(5, 2)
  discountType    DiscountType    @default(NONE) @map("discount_type")
  discountValue   Decimal         @default(0) @map("discount_value") @db.Decimal(14, 2)
  hostingName     String?         @map("hosting_name")
  hostingCycle    BillingCycle?   @map("hosting_cycle")
  hostingAmount   Decimal         @default(0) @map("hosting_amount") @db.Decimal(14, 2)
  oneOffSubtotal  Decimal         @default(0) @map("one_off_subtotal") @db.Decimal(14, 2)
  discountAmount  Decimal         @default(0) @map("discount_amount") @db.Decimal(14, 2)
  netOneOff       Decimal         @default(0) @map("net_one_off") @db.Decimal(14, 2)
  vatOneOff       Decimal         @default(0) @map("vat_one_off") @db.Decimal(14, 2)
  totalOneOff     Decimal         @default(0) @map("total_one_off") @db.Decimal(14, 2)
  recurringVat    Decimal         @default(0) @map("recurring_vat") @db.Decimal(14, 2)
  recurringTotal  Decimal         @default(0) @map("recurring_total") @db.Decimal(14, 2)
  notes           String?
  sentAt          DateTime?       @map("sent_at") @db.Timestamptz(3)
  decidedAt       DateTime?       @map("decided_at") @db.Timestamptz(3)
  createdByUserId String          @map("created_by_user_id") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  lead       Lead            @relation(fields: [leadId], references: [id], onDelete: Restrict)
  torVersion TorVersion?     @relation(fields: [torVersionId], references: [id], onDelete: Restrict)
  createdBy  User            @relation("QuotationCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  lines      QuotationLine[]

  @@index([leadId, createdAt(sort: Desc)])
  @@index([torVersionId])
  @@index([status, validUntil])
  @@map("quotations")
}

model QuotationLine {
  id          String            @id @default(uuid(7)) @db.Uuid
  quotationId String            @map("quotation_id") @db.Uuid
  position    Int
  kind        QuotationLineKind
  description String
  quantity    Decimal           @default(1) @db.Decimal(8, 2)
  unitPrice   Decimal           @map("unit_price") @db.Decimal(14, 2)
  lineTotal   Decimal           @map("line_total") @db.Decimal(14, 2)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Restrict)

  @@index([quotationId, position])
  @@map("quotation_lines")
}

/// Created exactly once per signed ToR version, in the same transaction as the second signature.
model ClientAccount {
  id                 String              @id @default(uuid(7)) @db.Uuid
  number             String              @unique
  leadId             String              @unique @map("lead_id") @db.Uuid
  torId              String              @map("tor_id") @db.Uuid
  signedTorVersionId String              @unique @map("signed_tor_version_id") @db.Uuid
  companyId          String?             @map("company_id") @db.Uuid
  name               String
  status             ClientAccountStatus @default(ACTIVE)
  goLiveDate         DateTime?           @map("go_live_date") @db.Date
  planName           String?             @map("plan_name")
  billingCycle       BillingCycle?       @map("billing_cycle")
  planAmount         Decimal             @default(0) @map("plan_amount") @db.Decimal(14, 2)
  currency           String              @default("KES")
  nextRenewalDate    DateTime?           @map("next_renewal_date") @db.Date
  convertedByUserId  String              @map("converted_by_user_id") @db.Uuid
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  lead          Lead       @relation(fields: [leadId], references: [id], onDelete: Restrict)
  tor           Tor        @relation(fields: [torId], references: [id], onDelete: Restrict)
  signedVersion TorVersion @relation(fields: [signedTorVersionId], references: [id], onDelete: Restrict)
  company       Company?   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  convertedBy   User       @relation("ClientConverter", fields: [convertedByUserId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@map("client_accounts")
}
