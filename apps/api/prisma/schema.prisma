// Autonova CRM — identity/access foundation and first lead lifecycle slice.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum AuditCategory {
  /// Business mutation, written in the same transaction as the change it describes.
  BUSINESS
  /// Authentication/security event (failed login, token reuse, ...), written on its own.
  SECURITY
}

enum LeadSource {
  REFERRAL
  INSTAGRAM
  WEBSITE
  WALK_IN
  EVENT
  COLD_OUTREACH
  EXISTING_CLIENT_UPSELL
}

enum ProductInterest {
  RETAIL_POS
  CAR_WASH_AUTOMATION
  ERP
  VISITOR_SECURITY_SYSTEM
  HIRING_PLATFORM
  CUSTOM_BUILD
}

enum LeadReminderStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum LeadReminderReason {
  SMTP_NOT_CONFIGURED
  DELIVERY_FAILED
  LEAD_NOT_ACTIVE
  FOLLOW_UP_CHANGED
  RECIPIENT_UNAVAILABLE
  TOO_OVERDUE
}

enum LeadStage {
  NEW_LEAD
  VISITS_AND_CALLS
  QUALIFIED
  SCOPE_ALIGNMENT
  TOR_QUOTE_SENT
  DISQUALIFIED
  WON
  LOST
}

enum LeadDisqualificationReason {
  NO_BUDGET
  NO_DECISION_MAKER
  NEED_DOES_NOT_FIT
  CHOSE_COMPETITOR
  UNRESPONSIVE
  TIMING_REVISIT_LATER
  OTHER
}

enum LeadTransitionSource {
  MANUAL
  SCHEDULED_REVISIT
}

/// A person who can sign in. Users are never hard-deleted: they are referenced by
/// audit events and (later) by leads, ToRs and payments. Use status = DISABLED instead.
model User {
  id           String     @id @default(uuid(7)) @db.Uuid
  email        String     @unique
  fullName     String     @map("full_name")
  passwordHash String?    @map("password_hash")
  status       UserStatus @default(INVITED)
  lastLoginAt  DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  roles             UserRole[]
  invitations       UserInvitation[]
  auditLogs         AuditLog[]
  sessions          Session[]
  mfa               UserMfa?
  ownedLeads        Lead[]             @relation("LeadOwner")
  createdLeads      Lead[]             @relation("LeadCreator")
  leadTransitions   LeadStageHistory[] @relation("LeadTransitionActor")
  lostLeads         Lead[]             @relation("LeadLostBy")
  disqualifiedLeads Lead[]             @relation("LeadDisqualifiedBy")
  leadReminders     LeadReminder[]     @relation("LeadReminderRecipient")

  @@map("users")
}

/// Hashed, single-use onboarding links. Plain invitation tokens are emailed once and never stored.
model UserInvitation {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt])
  @@map("user_invitations")
}

/// Lead/opportunity aggregate. Stage transitions and outcome history are separate records.
model Lead {
  id                     String                      @id @default(uuid(7)) @db.Uuid
  name                   String
  companyName            String?                     @map("company_name")
  phone                  String?
  email                  String?
  source                 LeadSource
  referrerName           String?                     @map("referrer_name")
  productInterest        ProductInterest?            @map("product_interest")
  legacyProductInterest  String?                     @map("legacy_product_interest")
  /// Comparison keys for duplicate detection; always written with the lead (domain/lead-duplicates.ts).
  phoneNormalized        String?                     @map("phone_normalized")
  companyNameNormalized  String?                     @map("company_name_normalized")
  notes                  String?
  estimatedValue         Decimal?                    @map("estimated_value") @db.Decimal(14, 2)
  currency               String                      @default("KES")
  stage                  LeadStage                   @default(NEW_LEAD)
  lostReason             String?                     @map("lost_reason")
  lostAt                 DateTime?                   @map("lost_at") @db.Timestamptz(3)
  lostByUserId           String?                     @map("lost_by_user_id") @db.Uuid
  disqualificationReason LeadDisqualificationReason? @map("disqualification_reason")
  disqualifiedAt         DateTime?                   @map("disqualified_at") @db.Timestamptz(3)
  disqualifiedByUserId   String?                     @map("disqualified_by_user_id") @db.Uuid
  revisitOn              DateTime?                   @map("revisit_on") @db.Date
  ownerUserId            String                      @map("owner_user_id") @db.Uuid
  createdByUserId        String                      @map("created_by_user_id") @db.Uuid
  nextAction             String                      @map("next_action")
  nextActionAt           DateTime                    @map("next_action_at") @db.Timestamptz(3)
  probability            Int?
  createdAt              DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner          User               @relation("LeadOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  creator        User               @relation("LeadCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  lostBy         User?              @relation("LeadLostBy", fields: [lostByUserId], references: [id], onDelete: Restrict)
  disqualifiedBy User?              @relation("LeadDisqualifiedBy", fields: [disqualifiedByUserId], references: [id], onDelete: Restrict)
  stageHistory   LeadStageHistory[]
  reminders      LeadReminder[]

  @@index([ownerUserId, stage, updatedAt(sort: Desc)])
  @@index([phoneNormalized])
  @@index([companyNameNormalized])
  @@index([nextActionAt])
  @@index([createdAt(sort: Desc)])
  @@map("leads")
}

/// Immutable domain history. The runtime DB role receives INSERT/SELECT only.
/// One delivery record per lead follow-up instant. (lead_id, due_at) is unique, so a follow-up is
/// reminded at most once no matter how often or from how many processes the worker runs.
model LeadReminder {
  id              String              @id @default(uuid(7)) @db.Uuid
  leadId          String              @map("lead_id") @db.Uuid
  recipientUserId String              @map("recipient_user_id") @db.Uuid
  dueAt           DateTime            @map("due_at") @db.Timestamptz(3)
  status          LeadReminderStatus  @default(PENDING)
  attempts        Int                 @default(0)
  nextAttemptAt   DateTime            @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  lastAttemptAt   DateTime?           @map("last_attempt_at") @db.Timestamptz(3)
  sentAt          DateTime?           @map("sent_at") @db.Timestamptz(3)
  reason          LeadReminderReason?
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  lead      Lead @relation(fields: [leadId], references: [id], onDelete: Restrict)
  recipient User @relation("LeadReminderRecipient", fields: [recipientUserId], references: [id], onDelete: Restrict)

  @@unique([leadId, dueAt])
  @@index([status, nextAttemptAt])
  @@map("lead_reminders")
}

model LeadStageHistory {
  id                     String                      @id @default(uuid(7)) @db.Uuid
  leadId                 String                      @map("lead_id") @db.Uuid
  fromStage              LeadStage?                  @map("from_stage")
  toStage                LeadStage                   @map("to_stage")
  actorUserId            String?                     @map("actor_user_id") @db.Uuid
  occurredAt             DateTime                    @default(now()) @map("occurred_at") @db.Timestamptz(3)
  reason                 String?
  disqualificationReason LeadDisqualificationReason? @map("disqualification_reason")
  revisitOn              DateTime?                   @map("revisit_on") @db.Date
  source                 LeadTransitionSource        @default(MANUAL)

  lead  Lead  @relation(fields: [leadId], references: [id], onDelete: Restrict)
  actor User? @relation("LeadTransitionActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([leadId, occurredAt(sort: Desc)])
  @@index([toStage, disqualificationReason, occurredAt(sort: Desc)])
  @@index([toStage, revisitOn])
  @@map("lead_stage_history")
}

/// One sign-in on one device. Access tokens carry its id (`sid`); the API checks on EVERY request
/// that the session is neither revoked nor expired, so revocation takes effect immediately.
model Session {
  id            String    @id @default(uuid(7)) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Absolute lifetime; idle timeout is an open decision (docs/06, S6).
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedReason String?   @map("revoked_reason")
  /// Set when the second factor was verified for this session. A user whose roles require MFA
  /// (Directors) has a *restricted* session until this is set (docs/06 "Director MFA").
  mfaVerifiedAt DateTime? @map("mfa_verified_at") @db.Timestamptz(3)
  ip            String?
  userAgent     String?   @map("user_agent")

  user          User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  refreshTokens RefreshToken[]

  /// "Active sessions of a user" (session list, revoke-all on disable/password change).
  @@index([userId, revokedAt])
  @@map("sessions")
}

/// Encrypted TOTP enrollment and verification state. Plaintext secrets are only handled by AuthMfaService.
model UserMfa {
  userId           String    @id @map("user_id") @db.Uuid
  secretCiphertext String?   @map("secret_ciphertext")
  secretIv         String?   @map("secret_iv")
  secretTag        String?   @map("secret_tag")
  enrolledAt       DateTime? @map("enrolled_at") @db.Timestamptz(3)
  lastAcceptedStep BigInt?   @map("last_accepted_step")
  failedAttempts   Int       @default(0) @map("failed_attempts")
  lockedUntil      DateTime? @map("locked_until") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user          User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  recoveryCodes MfaRecoveryCode[]

  @@map("user_mfa")
}

/// High-entropy one-time recovery code digests; plaintext is returned only once at enrollment.
model MfaRecoveryCode {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @unique @map("code_hash")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)

  mfa UserMfa @relation(fields: [userId], references: [userId], onDelete: Restrict)

  @@index([userId, usedAt])
  @@map("mfa_recovery_codes")
}

/// One refresh token issued for a session. A session IS the token family: every rotation of a
/// session's refresh token adds a row here, so revoking the session (sessions.revoked_at) revokes
/// all of its tokens and no separate family id or per-token revocation flag exists.
///
/// Only the SHA-256 of the opaque token is stored; the raw value exists in the HttpOnly cookie only.
/// Rotation consumes a token with a conditional UPDATE (used_at IS NULL), so exactly one concurrent
/// request wins; presenting an already-used token is replay and revokes the session.
/// The migration adds, by hand, a partial unique index (one unused token per session) and CHECKs.
model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  /// Lower-case hex SHA-256 of the raw token. Lookup key; UNIQUE so a hash can never match two rows.
  tokenHash String    @unique @map("token_hash")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Never later than the session's own expiry.
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  /// Set exactly once, by the rotation that consumed this token. Non-null means "already used".
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)

  session Session @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@index([sessionId])
  @@map("refresh_tokens")
}

/// Roles are data, not code, so permissions are never tied to individual people.
model Role {
  id          String   @id @default(uuid(7)) @db.Uuid
  key         String   @unique
  name        String
  description String?
  /// System roles are seeded and cannot be deleted or have their key changed.
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

/// A single capability, e.g. `users:manage`. Keys follow `<resource>:<action>`.
model Permission {
  id          String   @id @default(uuid(7)) @db.Uuid
  key         String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  roles RolePermission[]

  @@map("permissions")
}

/// Many-to-many: a role grants many permissions, a permission belongs to many roles.
model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// Many-to-many: one person can hold several roles (e.g. Director + Technical Lead).
model UserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

/// Append-only record of important business actions (PRD 2.2, 8.5).
/// UPDATE and DELETE are rejected by a database trigger (see the init migration).
/// old_values / new_values are JSON snapshots: they are document-like, vary by entity
/// and are never queried relationally.
model AuditLog {
  id          String        @id @default(uuid(7)) @db.Uuid
  occurredAt  DateTime      @default(now()) @map("occurred_at") @db.Timestamptz(3)
  /// Null only for system-initiated actions (jobs, seed).
  actorUserId String?       @map("actor_user_id") @db.Uuid
  category    AuditCategory @default(BUSINESS)
  action      String
  entityType  String        @map("entity_type")
  entityId    String        @map("entity_id")
  oldValues   Json?         @map("old_values")
  newValues   Json?         @map("new_values")
  reason      String?
  requestId   String?       @map("request_id")

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, occurredAt(sort: Desc)])
  @@index([actorUserId, occurredAt(sort: Desc)])
  @@index([occurredAt(sort: Desc)])
  @@index([category, occurredAt(sort: Desc)])
  @@map("audit_logs")
}
