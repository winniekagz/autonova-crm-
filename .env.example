# Copy to .env for local development. Never commit .env.
# --- PostgreSQL (docker compose) ---
POSTGRES_USER=autonova
POSTGRES_PASSWORD=autonova_dev_password
POSTGRES_DB=autonova
POSTGRES_PORT=5433

# --- API ---
NODE_ENV=development
API_PORT=4000
API_LOG_LEVEL=debug
# Runtime connection: the least-privilege role `autonova_app` (INSERT/SELECT only on audit_logs).
# Its password is set by `pnpm db:provision-app-role` from APP_DB_PASSWORD.
APP_DB_PASSWORD=autonova_app_dev_password
DATABASE_URL=postgresql://autonova_app:autonova_app_dev_password@localhost:5433/autonova?schema=public
# Owner connection: used ONLY for migrations and role provisioning (prisma.config.ts, scripts).
MIGRATION_DATABASE_URL=postgresql://autonova:autonova_dev_password@localhost:5433/autonova?schema=public
# Signs access tokens (HS256). Generate: openssl rand -base64 48. Minimum 32 characters; the process
# refuses to start without it, and refuses the placeholder below in production.
JWT_ACCESS_SECRET=change-me-generate-with-openssl-rand-base64-48
# Encrypts TOTP credentials at rest. Generate: openssl rand -base64 32. Never commit the real key.
MFA_ENCRYPTION_KEY=generate-with-openssl-rand-base64-32
ACCESS_TOKEN_TTL_SECONDS=900
# Absolute session lifetime (idle timeout is an open decision, docs/06 S6). Default 30 days.
SESSION_ABSOLUTE_TTL_SECONDS=2592000
# Refresh-token lifetime, renewed on every use, so it doubles as the idle timeout. Default 7 days.
# Never outlives the session's absolute lifetime above.
REFRESH_TOKEN_TTL_SECONDS=604800
# Number of reverse-proxy hops to trust for client IPs (rate limiting). 0 = none (direct).
TRUST_PROXY_HOPS=0
# Swagger UI. Defaults to on outside production and off in production.
# SWAGGER_ENABLED=true

# Comma-separated list of origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:3000,http://localhost:4000,http://localhost:4001
APP_BASE_URL=http://localhost:3000
# Local Compose uses Mailpit. For real delivery, set SMTP_URL to the provider's SMTP URL and
# MAIL_FROM to a sender address authorized by that provider. Keep SMTP credentials out of git.
SMTP_URL=smtp://localhost:1025
MAIL_FROM=Autonova CRM <no-reply@autonova.local>

# Argon2id password hashing cost (defaults shown). Benchmark per host: pnpm --filter @autonova/api run bench:argon2
ARGON2_MEMORY_KIB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1

# --- Web ---
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Private directory for uploaded visit-report attachments. Keep it outside any web-served path and back it up
# with the database. Local disk is for development and single-host use; production should move to object
# storage (docs/06 S9).
FILE_STORAGE_DIR=./storage
# Per-file limits and the total allowed on one visit report (MB). Defaults shown.
ATTACHMENT_PHOTO_MAX_MB=10
ATTACHMENT_DOCUMENT_MAX_MB=25
ATTACHMENT_VOICE_NOTE_MAX_MB=20
ACTIVITY_ATTACHMENT_TOTAL_MAX_MB=50
# Retention periods in months (GPS check-ins and voice notes). Nothing is deleted automatically: run
# `pnpm --filter @autonova/api retention:review` to list what is due and have a person approve a purge.
RETENTION_GPS_MONTHS=12
RETENTION_VOICE_NOTE_MONTHS=12
